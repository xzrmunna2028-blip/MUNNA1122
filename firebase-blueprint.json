{
  "entities": {
    "SmsLog": {
      "title": "SMS Log",
      "description": "Enterprise SMS log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "termination": { "type": "string" },
        "sid": { "type": "string" },
        "status": { "type": "string" },
        "text": { "type": "string" },
        "otp": { "type": "string" },
        "timestamp": { "type": "string" },
        "cost": { "type": "string" },
        "sender": { "type": "string" }
      },
      "required": ["id", "number", "text", "timestamp"]
    },
    "RentedNumber": {
      "title": "Rented Number",
      "description": "A rented range or virtual number",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "rangeName": { "type": "string" },
        "range": { "type": "string" },
        "allocatedAt": { "type": "string" },
        "status": { "type": "string" },
        "operator": { "type": "string" },
        "monthlyPrice": { "type": "string" },
        "rate": { "type": "string" },
        "term": { "type": "string" },
        "country": { "type": "string" },
        "cost": { "type": "string" }
      },
      "required": ["id", "number"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "System or user activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "event": { "type": "string" },
        "processedType": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["id", "timestamp", "event", "description"]
    },
    "SystemState": {
      "title": "System State",
      "description": "Global synchronized application state",
      "type": "object",
      "properties": {
        "last_updated": { "type": "string" },
        "iprn_api_key": { "type": "string" },
        "metrics": { "type": "object" },
        "realtime_counters": { "type": "object" },
        "chart_data": { "type": "array" }
      }
    },
    "UserRecord": {
      "title": "Registered User",
      "description": "User account registration record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "pass": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "created": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["name", "email", "status"]
    },
    "InvitationRecord": {
      "title": "Invitation Link",
      "description": "One-time registration invitation token",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "balance": { "type": "number" },
        "inviter": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "status": { "type": "string" },
        "link": { "type": "string" }
      },
      "required": ["token", "email", "name", "role", "balance", "createdAt", "expiresAt", "status", "link"]
    },
    "BroadcastRecord": {
      "title": "Broadcast Notice",
      "description": "Notice board message for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "targetRole": { "type": "string" },
        "pinned": { "type": "boolean" },
        "author": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "category", "targetRole", "pinned", "createdAt"]
    }
  },
  "firestore": {
    "settings/global": {
      "schema": "SystemState",
      "description": "Global system state and configuration"
    },
    "active_sms_logs/{logId}": {
      "schema": "SmsLog",
      "description": "Collection of incoming SMS logs"
    },
    "rented_numbers/{numberId}": {
      "schema": "RentedNumber",
      "description": "Collection of active and suspended rented numbers"
    },
    "activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Collection of system audit logs"
    },
    "registered_users/{email}": {
      "schema": "UserRecord",
      "description": "Registered users of the application"
    },
    "invitations/{token}": {
      "schema": "InvitationRecord",
      "description": "Active and expired invitation tokens"
    },
    "broadcast_notices/{noticeId}": {
      "schema": "BroadcastRecord",
      "description": "Global and targeted broadcast notifications"
    }
  }
}
